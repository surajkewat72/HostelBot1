generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  userType  String    @default("student")
  room      String?
  block     String?
  createdAt DateTime  @default(now())
  complaints Complaint[]
  votes     Vote[]
  feedbacks Feedback[]
}

model Staff {
  id         Int      @id @default(autoincrement())
  name       String
  department String
  complaints Complaint[] @relation("AssignedStaff")
}

model Complaint {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  category    String
  status      String    @default("Pending")
  date        DateTime  @default(now())
  room        String?
  block       String?
  imageUrl    String?
  student     User?     @relation(fields: [studentId], references: [id])
  studentId   Int?
  assignedTo  Staff?    @relation("AssignedStaff", fields: [assignedToId], references: [id])
  assignedToId Int?
  votes       Vote[]
  feedback    Feedback?
}

model Vote {
  id          Int      @id @default(autoincrement())
  voteType    String
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  complaintId Int
  createdAt   DateTime @default(now())
  @@unique([userId, complaintId])
}

model Feedback {
  id          Int      @id @default(autoincrement())
  rating      Int
  comment     String
  date        DateTime @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  complaintId Int @unique
  user        User?     @relation(fields: [userId], references: [id])
  userId      Int?
}
